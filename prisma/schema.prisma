// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  rollNo       String   @unique
  name         String
  passwordHash String
  role         String   @default("STUDENT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  answers     Answer[]
  submissions Submission[]

  @@index([rollNo])
}

model Event {
  id              String      @id @default(cuid())
  type            String      @unique
  name            String
  startTime       DateTime
  endTime         DateTime
  status          String      @default("DRAFT")
  durationSeconds Int
  version         Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  debuggingProblems DebuggingProblem[]
  quizQuestions     QuizQuestion[]
  answers           Answer[]
  submissions       Submission[]
}

model DebuggingProblem {
  id             String   @id @default(cuid())
  eventId        String
  title          String
  description    String
  buggyCode      String
  expectedOutput String
  // JSON: [{ input: string, expectedOutput: string }]
  testCases      String   @default("[]")
  points         Int      @default(100)
  timeLimit      Int      @default(5) // seconds per test case
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([eventId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  eventId       String
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   // "A" | "B" | "C" | "D"
  explanation   String   @default("")
  points        Int      @default(10)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([eventId])
}

model Answer {
  id             String   @id @default(cuid())
  userId         String
  eventId        String
  questionId     String
  selectedAnswer String   // "A" | "B" | "C" | "D"
  isCorrect      Boolean
  pointsAwarded  Int      @default(0)
  createdAt      DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId]) // one answer per question per student
  @@index([userId, eventId])
}

model Submission {
  id            String           @id @default(cuid())
  userId        String
  eventId       String
  problemId     String
  submittedCode String           
  result        String           @default("RUNTIME_ERROR")
  compileOutput String           @default("")
  runOutput     String           @default("")
  pointsAwarded Int              @default(0)
  submittedAt   DateTime         @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  problem DebuggingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, eventId])
}

model ThemeSettings {
  id              String   @id @default(cuid())
  name            String
  primaryColor    String
  secondaryColor  String
  accentColor     String
  backgroundColor String
  surfaceColor    String
  textColor       String
  isActive        Boolean  @default(false)
  version         Int      @default(0)
  updatedAt       DateTime @updatedAt
}
